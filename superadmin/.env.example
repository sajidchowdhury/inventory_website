# InventoryOS SuperAdmin — environment variables.
# Copy this file to `.env` and adjust. For local testing the defaults below
# work out of the box (SQLite at ./db/superadmin.db, mock bKash, log-mode
# email, dev auth secret). Set the real values only when deploying to the VPS.

# --- SuperAdmin's own database (SQLite) ---
DATABASE_URL=file:./db/superadmin.db

# --- Auth (HMAC-signed session cookies + SSO token signing) ---
# Generate with:  openssl rand -hex 32
AUTH_SECRET=inventoryos-superadmin-dev-secret-change-me
SSO_SECRET=

# --- Cron jobs (/api/cron/* accept this header instead of an admin session) ---
CRON_SECRET=

# --- bKash automated payments (tokenized checkout v1.2.0) ---
# Leave unset → mock mode (the full create→callback→auto-approve flow runs
# against /api/bkash/simulate, no real bKash call). Set all five for live.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://inventoryos.xyz/api/bkash/callback

# --- Dunning emails (nodemailer) ---
# Leave unset → emails log to /tmp/inventoryos-emails.log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=InventoryOS <noreply@inventoryos.xyz>
